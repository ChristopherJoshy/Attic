# ─────────────────────────────────────────────────
# SAHAYI BACKEND — ENVIRONMENT VARIABLES
# Team: Porottayum Beefum | TECHASHY'26
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────────

# GEMINI (Google AI Studio API)
GOOGLE_GEMINI_API=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# FIREBASE ADMIN (Doctor Google Auth)
FIREBASE_PROJECT_ID=your_firebase_project_id
SERVICE_ACCOUNT_FILE=./your-firebase-adminsdk.json

# TWILIO (Voice + WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+1xxxxxxxxxx
TWILIO_WEBHOOK_BASE=https://ce5a-117-250-240-128.ngrok-free.app

# SARVAM AI (Malayalam STT + TTS)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_LANGUAGE=ml-IN
SARVAM_TTS_SPEAKER=ritu

# DATABASE
DATABASE_URL=sqlite+aiosqlite:///./sahayi.db

# CHROMADB (RAG Vector Store)
CHROMA_PERSIST_DIR=./rag/chroma_store
CHROMA_COLLECTION_NAME=sahayi_medical_kb

# PUBMED API (free — no key needed, but set email)
PUBMED_EMAIL=your_email@example.com
PUBMED_MAX_RESULTS=3

# RISK SCORING THRESHOLDS
RISK_YELLOW_THRESHOLD=0.4
RISK_RED_THRESHOLD=0.7
ANOMALY_Z_SCORE_THRESHOLD=2.0
DOCTOR_ESCALATION_HOURS=3

# DASHBOARD SECURITY
DASHBOARD_AUTH_HEADER=X-Sahayi-Doctor-Token
DASHBOARD_SHARED_TOKEN=hackathon_demo_token

# SERVER
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
SECRET_KEY=your_secret_key_here_min_32_chars
FRONTEND_URL=http://localhost:5173

# VERTEX AI (Gemini via Google Cloud)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
